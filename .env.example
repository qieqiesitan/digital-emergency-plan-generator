# 复制为 .env 后按需修改（未设的项使用 compose 内默认值）

# JWT 签名密钥：生产环境建议改为随机长字符串（改动后所有登录态失效，需重新登录）
SECRET_KEY=emergency-plan-docker-secret-key-2026

# AI Key 加密密钥：**不要修改**，必须与数据来源一致
# （当前数据库中的 AI Key 使用 abcdefghijklmnopqrstuvwxyz123456 加密）
ENCRYPTION_KEY=abcdefghijklmnopqrstuvwxyz123456

# 数据库口令（postgres 服务使用，默认 postgres）
POSTGRES_PASSWORD=postgres

# 数据库迁移（可选）：
# 首次部署（schema_migrations 无记录）默认把已有迁移脚本记为 baseline（只记录不执行）。
# MIGRATE_FRESH 是 backend 进程环境变量（本 compose 已从 .env 透传），
# 仅在【空库】且需执行全部捆绑迁移时使用（逃生口）。设置方式：
#   - 本文件取消注释：MIGRATE_FRESH=1
#   - 或单次注入：docker compose run -e MIGRATE_FRESH=1 backend ... 或 export MIGRATE_FRESH=1
# 注意：已有数据的库不要开启——若库内尚无迁移记录，会把全部历史脚本当作新迁移执行。
# MIGRATE_FRESH=1

# 企查查智能体（可选，如需工商自动填充；留空表示不启用）
QCC_API_KEY=
QCC_API_KEY_FALLBACK=
QCC_ENDPOINT=https://agent.qcc.com/mcp/company/stream

# 高德开放平台 Web 服务 Key（留空占位，可在「第三方接口配置」页修改）
AMAP_KEY=
